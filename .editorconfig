# Shared editor settings. ktlint reads the max_line_length and ktlint_* keys; Palantir Java Format
# is fixed at four-space indentation and 120 columns, so Java and Kotlin share one line length.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{kt,kts}]
ktlint_code_style = ktlint_official

[*.{yml,yaml,toml}]
indent_style = space
indent_size = 2

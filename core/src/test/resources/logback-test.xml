<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender for test output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger set to TRACE for tests to see all debug output -->
    <root level="TRACE">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Project logger at TRACE level for detailed test debugging -->
    <logger name="org.github.krandom" level="TRACE"/>

    <!-- Suppress test framework noise -->
    <logger name="org.junit" level="WARN"/>
    <logger name="io.kotest" level="WARN"/>
</configuration>
